---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { site, telHref, mailHref, url, indirizzoRiga, localitaRiga } from '../data/site';
import { servizi } from '../data/servizi';
import { pagina, briciole, titolo } from '../lib/seo';

const title = titolo(`Contatti – ${[site.indirizzo.viaBreve, site.indirizzo.citta].filter(Boolean).join(', ')}`);
const description = `Contatta ${site.nome}: ${indirizzoRiga}, tel. ${site.telefono.testo}, ${site.email}.`;
const ld = [
  pagina({ tipo: 'ContactPage', path: '/contatti/', titolo: title, descrizione: description, og: site.og.src, briciole: true }),
  briciole('/contatti/', [
    { nome: 'Home', path: '/' },
    { nome: 'Contatti', path: '/contatti/' },
  ]),
  {
    '@type': 'ContactPoint',
    '@id': url('/contatti/#contatto'),
    contactType: 'customer service',
    telephone: site.telefono.href,
    email: site.email,
    areaServed: 'IT',
    availableLanguage: ['Italian'],
  },
];
// Modulo: con site.form.attivo = false il form non ha destinazione e non invia nulla
const { form } = site;
const formAttrs = form.attivo
  ? { method: 'POST', action: form.grazie, ...(form.netlify ? { 'data-netlify': 'true', 'netlify-honeypot': 'indirizzo-web' } : {}) }
  : { action: '#', 'data-form-disattivato': '' };
---
<Layout title={title} description={description} path="/contatti/" ogType="article" ld={ld}>
  <PageHead
    briciole={[{ nome: 'Contatti' }]}
    eyebrow="Contatti"
    lead="Scrivimi o chiamami per raccontarmi il tuo progetto di architettura, interni, allestimento o colore: valuteremo insieme la soluzione più adatta."
  >
    Parliamo del tuo progetto
  </PageHead>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-side">
        <div class="info-cards">
          <div class="info-card">
            <h2><Icon name="luogo" class="ic" /> Indirizzo</h2>
            <p>{site.indirizzo.via && <Fragment>{site.indirizzo.via}<br /></Fragment>}{localitaRiga}</p>
            <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-link link-underline">Indicazioni stradali</a>
          </div>
          <div class="info-card">
            <h2><Icon name="telefono" class="ic" /> Telefono</h2>
            <p><a href={telHref}>{site.telefono.testo}</a></p>
            <a href={telHref} class="text-link link-underline">Chiama ora</a>
          </div>
          <div class="info-card">
            <h2><Icon name="email" class="ic" /> Email</h2>
            <p><a href={mailHref}>{site.email}</a></p>
            <a href={mailHref} class="text-link link-underline">Scrivici</a>
          </div>
          <div class="info-card">
            <h2>Ricevimento</h2>
            <p>{site.ricevimento}</p>
          </div>
        </div>
        <div class="map-box">
          <MapEmbed delta={0.01} />
        </div>
        <p class="xs muted">Mappa © OpenStreetMap contributors</p>
      </div>
      <div id="richiesta" class="form-card">
        <h2 class="h3">Richiedi un preventivo</h2>
        <p class="mt-1 muted">Compila il modulo: ti ricontatteremo al più presto.</p>
        <form class="form" name={form.nome} {...formAttrs}>
          <input type="hidden" name="form-name" value={form.nome} />
          <p class="hp"><label>Non compilare: <input name="indirizzo-web" tabindex="-1" autocomplete="off" /></label></p>
          <div class="two">
            <div class="field"><label for="f-nome">Nome e cognome *</label><input id="f-nome" name="nome" required autocomplete="name" /></div>
            <div class="field"><label for="f-email">Email *</label><input id="f-email" name="email" type="email" required autocomplete="email" /></div>
          </div>
          <div class="two">
            <div class="field"><label for="f-tel">Telefono</label><input id="f-tel" name="telefono" type="tel" autocomplete="tel" /></div>
            <div class="field"><label for="f-comune">Comune dell’immobile</label><input id="f-comune" name="comune" autocomplete="address-level2" /></div>
          </div>
          <div class="field">
            <label for="f-servizio">Di cosa hai bisogno?</label>
            <select id="f-servizio" name="servizio">
              <option value="">Seleziona un servizio</option>
              {servizi.map((s) => <option>{s.nome}</option>)}
              <option>Altro</option>
            </select>
          </div>
          <div class="field">
            <label for="f-msg">Messaggio *</label>
            <textarea id="f-msg" name="messaggio" required placeholder="Descrivi brevemente l’immobile e l’intervento che desideri"></textarea>
          </div>
          <label class="check">
            <input type="checkbox" name="privacy" required />
            <span>Ho letto l’<a href="/privacy-policy/">informativa privacy</a> e acconsento al trattamento dei miei dati per essere ricontattato. *</span>
          </label>
          <div><button type="submit" class="btn btn-primary">Invia la richiesta</button></div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Form non ancora collegato: blocca l'invio (vedi site.form in src/data/site.ts)
  document.querySelectorAll<HTMLFormElement>('form[data-form-disattivato]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Modulo non ancora collegato: imposta site.form in src/data/site.ts.');
    }),
  );
</script>
