---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { site, telHref, mailHref, url, indirizzoRiga, localitaRiga } from '../data/site';
import { servizi } from '../data/servizi';
import { pagina, briciole, titolo } from '../lib/seo';
import { lingua, loc, percorsoIn, traduttore } from '../lib/lingua';
import { sitoIn } from '../data/site';

const L = lingua(Astro.url);
const tr = traduttore(L);
const s = sitoIn(L);
const tel = L === 'en' ? site.telefono.testoEn : site.telefono.testo;
const title = titolo(`${tr('Contatti', 'Contact')} – ${[site.indirizzo.viaBreve, site.indirizzo.citta].filter(Boolean).join(', ')}`);
const description = `${tr('Contatta', 'Contact')} ${site.nome}: ${indirizzoRiga}, tel. ${tel}, ${site.email}.`;
const ld = [
  pagina({ tipo: 'ContactPage', path: '/contatti/', titolo: title, descrizione: description, og: site.og.src, briciole: true }),
  briciole('/contatti/', [
    { nome: 'Home', path: '/' },
    { nome: tr("Contatti", "Contact"), path: '/contatti/' },
  ]),
  {
    '@type': 'ContactPoint',
    '@id': url(`${percorsoIn('/contatti/', L)}#contatto`),
    contactType: 'customer service',
    telephone: site.telefono.href,
    email: site.email,
    areaServed: 'IT',
    availableLanguage: ['Italian', 'English'],
  },
];
// Modulo: con site.form.attivo = false il form non ha destinazione e non invia nulla
const { form } = site;
const formAttrs = form.attivo
  ? { method: 'POST', action: percorsoIn(form.grazie, L), ...(form.netlify ? { 'data-netlify': 'true', 'netlify-honeypot': 'indirizzo-web' } : {}) }
  : { action: '#', 'data-form-disattivato': '' };
---
<Layout title={title} description={description} path="/contatti/" ogType="article" ld={ld}>
  <PageHead
    briciole={[{ nome: tr("Contatti", "Contact") }]}
    eyebrow={tr("Contatti", "Contact")}
    lead={tr("Scrivimi o chiamami per raccontarmi il tuo progetto di architettura, interni, allestimento o colore: valuteremo insieme la soluzione più adatta.", "Write or call to tell me about your architecture, interiors, exhibition or colour project: together we will find the best solution.")}
  >
    {tr("Parliamo del tuo progetto", "Let’s talk about your project")}
  </PageHead>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-side">
        <div class="info-cards">
          <div class="info-card">
            <h2><Icon name="luogo" class="ic" /> {tr("Indirizzo", "Address")}</h2>
            <p>{site.indirizzo.via && <Fragment>{site.indirizzo.via}<br /></Fragment>}{localitaRiga}</p>
            <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-link link-underline">{tr("Indicazioni stradali", "Directions")}</a>
          </div>
          <div class="info-card">
            <h2><Icon name="telefono" class="ic" /> {tr("Telefono", "Phone")}</h2>
            <p><a href={telHref}>{tel}</a></p>
            <a href={telHref} class="text-link link-underline">{tr("Chiama ora", "Call now")}</a>
          </div>
          <div class="info-card">
            <h2><Icon name="email" class="ic" /> Email</h2>
            <p><a href={mailHref}>{site.email}</a></p>
            <a href={mailHref} class="text-link link-underline">{tr("Scrivici", "Write to us")}</a>
          </div>
          <div class="info-card">
            <h2>{tr("Ricevimento", "Meetings")}</h2>
            <p>{s.ricevimento}</p>
          </div>
        </div>
        <div class="map-box">
          <MapEmbed delta={0.01} />
        </div>
        <p class="xs muted">{tr("Mappa", "Map")} © OpenStreetMap contributors</p>
      </div>
      <div id="richiesta" class="form-card">
        <h2 class="h3">{tr("Scrivimi", "Write to me")}</h2>
        <p class="mt-1 muted">{tr("Compila il modulo: ti ricontatterò al più presto.", "Fill in the form and I will get back to you as soon as possible.")}</p>
        <form class="form" name={form.nome} {...formAttrs}>
          <input type="hidden" name="form-name" value={form.nome} />
          <p class="hp"><label>{tr("Non compilare", "Do not fill in")}: <input name="indirizzo-web" tabindex="-1" autocomplete="off" /></label></p>
          <div class="two">
            <div class="field"><label for="f-nome">{tr("Nome e cognome", "Full name")} *</label><input id="f-nome" name="nome" required autocomplete="name" /></div>
            <div class="field"><label for="f-email">Email *</label><input id="f-email" name="email" type="email" required autocomplete="email" /></div>
          </div>
          <div class="two">
            <div class="field"><label for="f-tel">{tr("Telefono", "Phone")}</label><input id="f-tel" name="telefono" type="tel" autocomplete="tel" /></div>
            <div class="field"><label for="f-comune">{tr("Comune dell’immobile", "Town of the property")}</label><input id="f-comune" name="comune" autocomplete="address-level2" /></div>
          </div>
          <div class="field">
            <label for="f-servizio">{tr("Di cosa hai bisogno?", "What do you need?")}</label>
            <select id="f-servizio" name="servizio">
              <option value="">{tr("Seleziona un servizio", "Choose a service")}</option>
              {servizi.map((x) => <option>{loc(x, L).nome}</option>)}
              <option>{tr("Altro", "Other")}</option>
            </select>
          </div>
          <div class="field">
            <label for="f-msg">{tr("Messaggio", "Message")} *</label>
            <textarea id="f-msg" name="messaggio" required placeholder={tr("Descrivi brevemente l’immobile e l’intervento che desideri", "Briefly describe the property and the work you have in mind")}></textarea>
          </div>
          <label class="check">
            <input type="checkbox" name="privacy" required />
            <span>{L === 'en' ? <Fragment>I have read the <a href="/privacy-policy/">privacy notice</a> and agree to my data being processed so that I can be contacted. *</Fragment> : <Fragment>Ho letto l’<a href="/privacy-policy/">informativa privacy</a> e acconsento al trattamento dei miei dati per essere ricontattato. *</Fragment>}</span>
          </label>
          <div><button type="submit" class="btn btn-primary">{tr("Invia la richiesta", "Send your request")}</button></div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Form non ancora collegato: blocca l'invio (vedi site.form in src/data/site.ts)
  document.querySelectorAll<HTMLFormElement>('form[data-form-disattivato]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Modulo non ancora collegato: imposta site.form in src/data/site.ts.');
    }),
  );
</script>
