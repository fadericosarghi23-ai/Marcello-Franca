---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Cta from '../../components/Cta.astro';
import { site, url } from '../../data/site';
import { scritti } from '../../data/scritti';
import { pagina, briciole, titolo } from '../../lib/seo';
import { dataEstesa } from '../../lib/date';
import { lingua, loc, percorsoIn, traduttore } from '../../lib/lingua';

const L = lingua(Astro.url);
const tr = traduttore(L);
const pre = L === 'en' ? '/en' : '';
const path = percorsoIn('/scritti/', L);
const lista = scritti.map((s) => loc(s, L));
const title = titolo(tr("Scritti: la città, il colore, il maestro", "Writings: the city, colour, the mentor"));
const description = tr(
  `Gli scritti di ${site.nome}: l’immagine della città, il colore e la memoria dei luoghi, i ricordi di Michele Provinciali.`,
  `Writings by ${site.nome}: the image of the city, colour and the memory of places, memories of Michele Provinciali.`,
);
const ld = [
  pagina({ tipo: 'CollectionPage', path, titolo: title, descrizione: description, og: site.og.src, briciole: true }),
  briciole(path, [
    { nome: 'Home', path: percorsoIn('/', L) },
    { nome: tr("Scritti", "Writings"), path },
  ]),
  {
    '@type': 'ItemList',
    name: tr("Scritti", "Writings"),
    numberOfItems: lista.length,
    itemListElement: lista.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: url(`${pre}/scritti/${s.slug}/`), name: s.titolo })),
  },
];
---
<Layout title={title} description={description} path={path} ld={ld}>
  <PageHead
    briciole={[{ nome: tr("Scritti", "Writings") }]}
    eyebrow={tr("Scritti", "Writings")}
    lead={tr("Riflessioni sull’immagine della città e sul colore, e i ricordi del maestro Michele Provinciali.", "Reflections on the image of the city and on colour, and memories of my mentor Michele Provinciali.")}
  >
    {tr("Scritti", "Writings")}
  </PageHead>

  <section class="section">
    <div class="container">
      <ol class="elenco">
        {
          lista.map((s) => (
            <li class="reveal">
              <a href={`/scritti/${s.slug}/`} class="voce">
                <div class="testo">
                  <p class="data">{dataEstesa(s.data, L)}{L === 'en' && !s.en?.blocchi && ' · in Italian'}</p>
                  <h2 class="h3">{s.titolo}</h2>
                  <p class="estratto">{s.estratto}</p>
                  <span class="text-link link-underline">{tr("Leggi", "Read")}</span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Cta />
</Layout>

<style>
  .elenco {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .elenco li {
    border-top: 1px solid var(--line);
  }
  .elenco li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .voce {
    display: grid;
    gap: 1.5rem;
    padding: 2rem 0;
    color: inherit;
    text-decoration: none;
  }
  .data {
    color: var(--grey);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .voce h2 {
    margin-bottom: 0.75rem;
    transition: color 0.3s;
  }
  .voce:hover h2 {
    color: var(--grey);
  }
  .estratto {
    max-width: 44rem;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
