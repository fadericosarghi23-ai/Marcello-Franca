---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { pagina, titolo } from '../lib/seo';
import { lingua, loc, percorsoIn, traduttore } from '../lib/lingua';

const L = lingua(Astro.url);
const tr = traduttore(L);
const pre = L === 'en' ? '/en' : '';
const title = titolo(tr("Richiesta inviata", "Request sent"));
const description = tr("Grazie per averci contattato: ti risponderemo al più presto.", "Thank you for getting in touch: we will reply as soon as possible.");
const ld = [pagina({ path: percorsoIn('/grazie/', L), titolo: title, descrizione: description, og: site.og.src })];
---
<Layout title={title} description={description} path="/grazie/" noindex ld={ld}>
  <section class="page-head bg-sand" style="min-height: 70svh">
    <div class="container narrow">
      <p class="eyebrow mb-2">{tr("Grazie", "Thank you")}</p>
      <h1 class="h1-page">{tr("Abbiamo ricevuto la tua richiesta", "We have received your request")}</h1>
      <p class="lead mt-3">{tr("Ti ricontatteremo al più presto. Nel frattempo puoi dare un’occhiata ai nostri progetti.", "We will get back to you as soon as possible. In the meantime, have a look at our projects.")}</p>
      <div class="btn-row mt-4">
        <a href="/progetti/" class="btn btn-primary">{tr("Guarda i progetti", "See the projects")}</a>
        <a href="/" class="btn btn-outline">{tr("Torna alla home", "Back to home")}</a>
      </div>
    </div>
  </section>
</Layout>
