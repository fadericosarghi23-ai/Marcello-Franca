---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { pagina, titolo } from '../lib/seo';

const title = titolo('Richiesta inviata');
const description = 'Grazie per averci contattato: ti risponderemo al più presto.';
const ld = [pagina({ path: '/grazie/', titolo: title, descrizione: description, og: site.og.src })];
---
<Layout title={title} description={description} path="/grazie/" noindex ld={ld}>
  <section class="page-head bg-sand" style="min-height: 70svh">
    <div class="container narrow">
      <p class="eyebrow mb-2">Grazie</p>
      <h1 class="h1-page">Abbiamo ricevuto la tua richiesta</h1>
      <p class="lead mt-3">Ti ricontatteremo al più presto. Nel frattempo puoi dare un’occhiata ai nostri progetti.</p>
      <div class="btn-row mt-4">
        <a href="/progetti/" class="btn btn-primary">Guarda i progetti</a>
        <a href="/" class="btn btn-outline">Torna alla home</a>
      </div>
    </div>
  </section>
</Layout>
