---
// /progetti/<categoria>/ e /progetti/<progetto>/ condividono lo stesso livello di URL
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Portfolio from '../../components/Portfolio.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import Cta from '../../components/Cta.astro';
import { site, url } from '../../data/site';
import { progetti, categorie, type Progetto, type Categoria } from '../../data/progetti';
import { diCategoria, testoPiano } from '../../lib/progetti';
import { membro } from '../../data/team';
import { pagina, briciole, titolo, tronca, ogPath } from '../../lib/seo';
import { fallbackSrc } from '../../lib/img';
import { lingua, loc, percorsoIn, traduttore } from '../../lib/lingua';

export function getStaticPaths() {
  return [
    ...categorie.map((c) => ({ params: { slug: c.id }, props: { categoria: c } })),
    ...progetti.map((p) => ({ params: { slug: p.slug }, props: { progetto: p } })),
  ];
}

const L = lingua(Astro.url);
const tr = traduttore(L);
const props = Astro.props as { categoria?: Categoria; progetto?: Progetto };
const categoria = props.categoria && loc(props.categoria, L);
const progetto = props.progetto;
const path = percorsoIn(`/progetti/${Astro.params.slug}/`, L);
const pre = L === 'en' ? '/en' : '';

let title: string, description: string, og: string, ogAlt: string | undefined, ld: object[];
const lista = categoria ? diCategoria(categoria.id) : [];

if (categoria) {
  title = titolo(categoria.metaTitle);
  description = categoria.metaDescription;
  og = lista[0] ? ogPath(lista[0].slug) : site.og.src;
  ld = [
    pagina({ tipo: 'CollectionPage', path, titolo: title, descrizione: description, og, briciole: true }),
    briciole(path, [
      { nome: 'Home', path: '/' },
      { nome: tr('Progetti', 'Projects'), path: `${pre}/progetti/` },
      { nome: categoria.nome, path },
    ]),
    {
      '@type': 'ItemList',
      name: categoria.nome,
      numberOfItems: lista.length,
      itemListElement: lista.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: url(`${pre}/progetti/${p.slug}/`), name: loc(p, L).titolo })),
    },
  ];
} else {
  const p = loc(progetto!, L);
  const cat = loc(categorie.find((c) => c.id === p.categorie[0])!, L);
  title = titolo(`${p.titolo} – ${p.luogo}`, p.titolo);
  description = tronca(`${p.titolo}, ${p.luogo}: ${testoPiano(p.testo)}`);
  og = ogPath(p.slug);
  ogAlt = (L === 'en' && p.copertina.altEn) || p.copertina.alt;
  const ref = membro(p.referente);
  ld = [
    pagina({ tipo: 'ItemPage', path, titolo: title, descrizione: description, og, briciole: true }),
    briciole(path, [
      { nome: 'Home', path: '/' },
      { nome: tr('Progetti', 'Projects'), path: `${pre}/progetti/` },
      { nome: cat.nome, path: `${pre}/progetti/${cat.id}/` },
      { nome: p.titolo, path },
    ]),
    {
      '@type': 'CreativeWork',
      '@id': url(`${path}#progetto`),
      name: p.titolo,
      alternativeHeadline: p.intervento,
      description: testoPiano(p.testo),
      url: url(path),
      inLanguage: L === 'en' ? 'en-GB' : 'it-IT',
      genre: p.categorie.map((c) => loc(categorie.find((x) => x.id === c)!, L).nome),
      keywords: [...p.tag, p.luogo, site.nome].join(', '),
      image: p.galleria.map((g) => ({ '@type': 'ImageObject', contentUrl: url(fallbackSrc(g.img)), caption: (L === 'en' && g.img.altEn) || g.img.alt, width: g.img.w, height: g.img.h })),
      locationCreated: { '@type': 'Place', name: p.luogo, address: { '@type': 'PostalAddress', addressLocality: p.luogo, addressCountry: 'IT' } },
      creator: [{ '@id': `${site.dominio}/#organizzazione` }, ...(ref ? [{ '@id': url(`/studio/#${ref.id}`) }] : [])],
      isPartOf: { '@id': url(`${pre}/progetti/#pagina`) },
    },
  ];
}
---
<Layout
  title={title}
  description={description}
  path={path}
  og={og}
  ogAlt={ogAlt}
  ogType={progetto ? 'article' : 'website'}
  transparent={!!progetto?.hero}
  ld={ld}
>
  {
    categoria ? (
      <Fragment>
        <PageHead briciole={[{ nome: tr('Progetti', 'Projects'), path: '/progetti/' }, { nome: categoria.nome }]} eyebrow="Portfolio" lead={categoria.intro}>
          {categoria.nome}
        </PageHead>
        <Portfolio lista={lista} attiva={categoria.id} />
        <Cta />
      </Fragment>
    ) : (
      <ProjectDetail p={progetto!} />
    )
  }
</Layout>
