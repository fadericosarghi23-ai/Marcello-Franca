---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Portfolio from '../../components/Portfolio.astro';
import Cta from '../../components/Cta.astro';
import { site, url } from '../../data/site';
import { progetti } from '../../data/progetti';
import { portfolio } from '../../lib/progetti';
import { pagina, briciole, titolo } from '../../lib/seo';

const n = progetti.length;
const title = titolo('[[DA COMPILARE: meta title portfolio, max 45 caratteri]]');
const description = `Portfolio di ${site.nome}: ${n} [[DA COMPILARE: progetti di ... a ..., completa fino a 150 caratteri]]`;
const ld = [
  pagina({ tipo: 'CollectionPage', path: '/progetti/', titolo: title, descrizione: description, og: site.og.src, briciole: true }),
  briciole('/progetti/', [
    { nome: 'Home', path: '/' },
    { nome: 'Progetti', path: '/progetti/' },
  ]),
  {
    '@type': 'ItemList',
    name: 'Progetti',
    numberOfItems: n,
    itemListElement: portfolio.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: url(`/progetti/${p.slug}/`), name: p.titolo })),
  },
];
---
<Layout title={title} description={description} path="/progetti/" ld={ld}>
  <PageHead
    briciole={[{ nome: 'Progetti' }]}
    eyebrow="Portfolio"
    lead={`${n} [[DA COMPILARE: progetti realizzati da ... tra ...: tipologie di lavori, 1 frase (circa 200 caratteri)]]`}
  >
    Progetti
  </PageHead>
  <Portfolio lista={portfolio} />
  <Cta />
</Layout>
