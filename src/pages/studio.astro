---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Cta from '../components/Cta.astro';
import Committenti from '../components/Committenti.astro';
import Traguardi from '../components/Traguardi.astro';
import { committenti, traguardi, copertine, maestro, arte } from '../data/reputazione';
import { site } from '../data/site';
import { team } from '../data/team';
import { pagina, briciole, titolo } from '../lib/seo';
import { studioTestata, studioFoto, numeriStudio } from '../data/sezioni';
import { progetti } from '../data/progetti';

const title = titolo('Marcello Franca, architetto a Pesaro dal 1985');
const description = 'Marcello Franca, architetto a Pesaro dal 1985: la formazione al Politecnico di Torino, il colore come filo conduttore, i committenti pubblici e privati.';
const og = '/img/og/studio.jpg';
const heroImg = studioTestata;
const foto = studioFoto;
const numeri = numeriStudio.map((x) => ({
  label: x.label,
  n: x.auto === 'team' ? team.length : x.auto === 'progetti' ? progetti.length : x.auto ? team.filter((m) => m.ruolo === x.auto).length : x.n,
}));
const approccio = [
  {
    titolo: 'Il colore è luce',
    testo: 'Indagare la realtà attraverso i colori è un modo per comprendere le cose: luce, colore e materia guidano ogni progetto, dall’edificio al Piano del Colore.',
  },
  {
    titolo: 'La memoria dei luoghi',
    testo: 'Con rispetto, ma con spirito critico, per la storia, la tradizione e la cultura dei luoghi, reinterpreto il progetto con uno stile moderno legato al filo della memoria.',
  },
  {
    titolo: 'Una visione globale',
    testo: 'Dalla scala urbana all’oggetto, coordino gruppi di lavoro eterogenei su progetti complessi, seguendo le idee dallo sviluppo alla realizzazione.',
  },
];
const competenze = [
  'Progettazione architettonica e direzione lavori',
  'Architettura d’interni e arredo su misura',
  'Allestimenti museali, fieristici e teatrali',
  'Piani del Colore e restyling cromatico',
  'Spazio urbano, verde e urbanistica',
  'Disegno industriale e segnaletica',
  'Pubblicazioni e incontri sul colore',
];
const ld = [
  pagina({ tipo: 'AboutPage', path: '/studio/', titolo: title, descrizione: description, og, briciole: true }),
  briciole('/studio/', [
    { nome: 'Home', path: '/' },
    { nome: 'Lo studio', path: '/studio/' },
  ]),
];
---
<Layout title={title} description={description} path="/studio/" og={og} ogType="article" transparent ld={ld}>
  <PageHero
    img={heroImg}
    briciole={[{ nome: 'Lo studio' }]}
    eyebrow="Lo studio"
    lead="Architetto a Pesaro dal 1985: architettura, interni, allestimenti, design e Piani del Colore, con una visione progettuale globale."
  >
    Architettura e colore, <em style="color: var(--accent-on-dark)">sul filo della memoria</em>
  </PageHero>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow mb-2">Chi sono</p>
        <h2 class="h2">{site.ragioneSociale}</h2>
      </div>
      <div class="prose lead reveal">
        <p>
          <strong>{site.sigla}</strong> è nato nel 1959 a Pesaro, dove vive e lavora come architetto dal 1985, dopo la laurea al Politecnico di Torino con una tesi sul colore nel paesaggio urbano lungo il mare.
        </p>
        <p>
          Ha collaborato agli allestimenti del Rossini Opera Festival, ideato il Motomuseo Morbidelli e il “Morbidelli Corner” al Barber Vintage Motorsports Museum di Birmingham (Alabama) e curato il Piano del Colore del centro storico di Pesaro.
        </p>
        <p>
          Dall’incontro con Michele Provinciali, amico e maestro, è nata la sensibilità per il mondo delle cose e per la relazione tra luce, colore e materia; dal 2002 partecipa con l’Associazione “La Ginestra” a numerose mostre d’arte.
        </p>
      </div>
    </div>
    <div class="container mt-4">
      <div class="stats reveal">
        {numeri.map((n) => <div class="stat"><strong>{n.n}</strong><span>{n.label}</span></div>)}
      </div>
    </div>
  </section>

  <section class="section bg-sand">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Approccio</p>
          <h2 class="h2">Il mio approccio</h2>
        </div>
      </div>
      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2.5rem">
        {
          approccio.map((a, i) => (
            <div class="reveal border-top" style={`padding-top: 1.5rem; transition-delay: ${i * 80}ms`}>
              <p class="eyebrow mb-2">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="h3 mb-2">{a.titolo}</h3>
              <p>{a.testo}</p>
            </div>
          ))
        }
      </div>
      <div class="grid-2 mt-4">
        {
          foto.map((f) => (
            <div class="ratio-32 reveal">
              <Picture img={f} sizes="(min-width: 1024px) 45vw, 92vw" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="team">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">L’architetto</p>
          <h2 class="h2">Marcello Franca, architetto</h2>
          <p class="lead mt-2">Coordino di volta in volta gruppi di lavoro con architetti, ingegneri, geometri e studi di design.</p>
        </div>
      </div>
      <ul class="team-grid">
        {
          team.map((m, i) => (
            <li class="member reveal" id={m.id} style={`transition-delay: ${(i % 4) * 60}ms`}>
              <div class="photo">
                <Picture img={m.foto} sizes="(min-width: 1100px) 22vw, (min-width: 768px) 30vw, 46vw" />
              </div>
              <h3>{m.nome}</h3>
              <p>{m.ruolo}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-sand" id="maestro">
    <div class="container split">
      <div class="reveal">
        <div class="ratio-45">
          <Picture img={maestro.foto} sizes="(min-width: 1024px) 38vw, 92vw" />
        </div>
      </div>
      <div class="reveal">
        <p class="eyebrow mb-2">Il maestro</p>
        <h2 class="h2">Michele Provinciali</h2>
        <div class="prose mt-3 lead">
          {maestro.testo.map((t) => <p>{t}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="pubblicazioni">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Percorso</p>
          <h2 class="h2">Pubblicazioni, mostre e riconoscimenti</h2>
          <p class="lead mt-2">Quarant’anni di progetti, scritti e mostre attorno a un filo conduttore: il colore nell’ambiente costruito.</p>
        </div>
      </div>
      <Traguardi voci={traguardi} copertine={copertine} />
    </div>
  </section>

  <section class="section bg-sand" id="committenti">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Committenti</p>
          <h2 class="h2">Hanno lavorato con me</h2>
          <p class="lead mt-2">Progettista e consulente per enti pubblici, istituzioni culturali, associazioni e aziende.</p>
        </div>
      </div>
      <Committenti gruppi={committenti} />
    </div>
  </section>

  <section class="section" id="arte">
    <div class="container split split-rev">
      <div class="reveal" style="order: 2">
        <div class="ratio-32">
          <Picture img={arte.foto} sizes="(min-width: 1024px) 45vw, 92vw" />
        </div>
      </div>
      <div class="reveal">
        <p class="eyebrow mb-2">Arte e fotografia</p>
        <h2 class="h2">Lo sguardo del fotografo</h2>
        <p class="lead mt-3">{arte.testo}</p>
        <ul class="checklist mt-4">
          {arte.mostre.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-sand">
    <div class="container grid-2">
      <div class="reveal">
        <p class="eyebrow mb-2">La sede</p>
        <h2 class="h2">{[site.indirizzo.via, site.indirizzo.citta].filter(Boolean).join(', ')}</h2>
        <p class="lead mt-3">Lo studio si trova a {[site.indirizzo.citta, site.indirizzo.zona].filter(Boolean).join(', ')}. {site.ricevimento}</p>
        <div class="btn-row mt-4">
          <a href="/contatti/" class="btn btn-primary">Contatti e orari</a>
          <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn btn-outline">Indicazioni stradali</a>
        </div>
      </div>
      <div class="reveal">
        <ul class="checklist lead">
          {competenze.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Cta />
</Layout>
