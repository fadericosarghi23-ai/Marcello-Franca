---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProcessCards from '../components/ProcessCards.astro';
import Percorso from '../components/Percorso.astro';
import Cta from '../components/Cta.astro';
import { site, url } from '../data/site';
import { ctaPrincipale } from '../data/nav';
import { processo, fasi } from '../data/metodo';
import { pagina, briciole, titolo } from '../lib/seo';

const title = titolo('Metodo di lavoro: dall’osservazione al progetto');
const description = 'Le 9 fasi con cui Marcello Franca segue ogni progetto: incontro, rilievo, analisi del luogo, simulazioni, colore, progetto, pratiche e direzione lavori.';
const og = '/img/og/metodo.jpg';
const ld = [
  pagina({ path: '/metodo/', titolo: title, descrizione: description, og, briciole: true }),
  briciole('/metodo/', [
    { nome: 'Home', path: '/' },
    { nome: 'Metodo', path: '/metodo/' },
  ]),
  {
    '@type': 'HowTo',
    '@id': url('/metodo/#metodo'),
    name: `Come lavora ${site.nome}`,
    description: 'Le fasi con cui l’architetto Marcello Franca segue un progetto, dal primo incontro alla consegna dell’opera.',
    step: fasi.map((f, i) => ({ '@type': 'HowToStep', position: i + 1, name: f.titolo, text: f.testo, url: url(`/metodo/#fase-${i + 1}`) })),
  },
];
---
<Layout title={title} description={description} path="/metodo/" og={og} transparent ld={ld}>
  <PageHero
    img={processo[3].img}
    briciole={[{ nome: 'Metodo' }]}
    eyebrow="Metodo"
    lead="Osservare, ascoltare, progettare e seguire la realizzazione: ogni progetto nasce dal dialogo con i luoghi e con chi li vive."
  >
    Dall’osservazione dei luoghi al progetto
  </PageHero>

  <section class="section">
    <div class="container">
      <ProcessCards h="h2" />
    </div>
  </section>

  <section class="section bg-sand">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow mb-2">Le fasi nel dettaglio</p>
          <h2 class="h2">Nove passaggi, un solo riferimento</h2>
          <p class="lead mt-2">Ogni progetto è diverso, ma il metodo è lo stesso: chiarezza su idee, tempi e costi in ogni fase.</p>
        </div>
        <a href={ctaPrincipale.href} class="btn btn-primary">Fissa un primo incontro</a>
      </div>
      <Percorso fasi={fasi} />
    </div>
  </section>

  <Cta titolo="Iniziamo da un incontro" />
</Layout>
