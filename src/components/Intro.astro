---
// Intro all'apertura del sito: il marchio si disegna, il nome entra lettera per lettera, poi il sipario sale.
// Si vede una volta per visita (sessionStorage) e mai con "riduci movimento": lo decide lo script inline
// nel <head> del Layout aggiungendo la classe .con-intro a <html> prima del primo disegno della pagina.
import { site } from '../data/site';

const nome = [...site.nome];
const sotto = 'Architetto · ' + site.indirizzo.citta;
---
{
  site.logo.marchio && (
    <div class="intro" aria-hidden="true" data-intro>
      <div class="intro-centro">
        <img class="intro-marchio" src={site.logo.marchio} alt="" width="160" height="160" />
        <p class="intro-nome">
          {nome.map((c, i) => (
            <span style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>
          ))}
        </p>
        <span class="intro-filo" />
        <p class="intro-sotto">{sotto}</p>
      </div>
    </div>
  )
}

<style>
  .intro {
    display: none;
  }
  :global(html.con-intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: #fff;
    cursor: pointer;
    transition: translate 1s cubic-bezier(0.76, 0, 0.24, 1);
    /* sicurezza: se lo script non partisse, il sipario sale comunque */
    animation: intro-via 1s cubic-bezier(0.76, 0, 0.24, 1) 6s forwards;
  }
  @keyframes intro-via {
    to {
      translate: 0 -100%;
      visibility: hidden;
    }
  }
  :global(html.con-intro.intro-esce) .intro {
    translate: 0 -100%;
  }
  .intro-centro {
    display: grid;
    justify-items: center;
    text-align: center;
    transition:
      opacity 0.6s var(--ease),
      translate 0.8s var(--ease);
  }
  :global(html.intro-esce) .intro-centro {
    opacity: 0;
    translate: 0 -40px;
  }

  /* 1. il marchio si disegna dal basso */
  .intro-marchio {
    width: clamp(110px, 18vw, 160px);
    height: auto;
    clip-path: inset(100% 0 0 0);
    animation: intro-disegna 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.15s forwards;
  }
  @keyframes intro-disegna {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* 2. il nome entra lettera per lettera */
  .intro-nome {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    overflow: hidden;
    padding-bottom: 0.1em;
  }
  .intro-nome span {
    display: inline-block;
    translate: 0 110%;
    opacity: 0;
    animation: intro-lettera 0.8s var(--ease) forwards;
    animation-delay: calc(0.75s + var(--i) * 0.045s);
  }
  @keyframes intro-lettera {
    to {
      translate: 0 0;
      opacity: 1;
    }
  }

  /* 3. un filo si allunga, poi la professione */
  .intro-filo {
    display: block;
    width: 6rem;
    height: 1px;
    margin: 1.1rem 0 1rem;
    background: #ffffff80;
    transform: scaleX(0);
    animation: intro-filo 0.9s var(--ease) 1.35s forwards;
  }
  @keyframes intro-filo {
    to {
      transform: scaleX(1);
    }
  }
  .intro-sotto {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #ffffffa6;
    opacity: 0;
    animation: intro-sotto 1s var(--ease) 1.6s forwards;
  }
  @keyframes intro-sotto {
    from {
      letter-spacing: 0.1em;
    }
    to {
      opacity: 1;
      letter-spacing: 0.32em;
    }
  }

  /* la testata della pagina parte quando il sipario sale */
  :global(html.con-intro .hero-content > *),
  :global(html.con-intro .page-hero .inner > *),
  :global(html.con-intro .page-head .container > *) {
    animation-play-state: paused;
  }
  :global(html.con-intro.intro-esce .hero-content > *),
  :global(html.con-intro.intro-esce .page-hero .inner > *),
  :global(html.con-intro.intro-esce .page-head .container > *) {
    animation-play-state: running;
  }
</style>

<script>
  // Tempi dell'intro: dopo 2,6 s (o al clic) il sipario sale; a fine corsa l'intro sparisce del tutto.
  const html = document.documentElement;
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  if (intro && html.classList.contains('con-intro')) {
    document.body.style.overflow = 'hidden';
    let uscita = false;
    const esci = () => {
      if (uscita) return;
      uscita = true;
      html.classList.add('intro-esce');
      document.body.style.overflow = '';
      setTimeout(() => {
        html.classList.remove('con-intro', 'intro-esce');
        intro.remove();
      }, 1100);
    };
    setTimeout(esci, 2600);
    intro.addEventListener('click', esci);
    document.addEventListener('keydown', esci, { once: true });
  }
</script>
