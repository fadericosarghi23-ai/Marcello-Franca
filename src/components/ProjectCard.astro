---
import Picture from './Picture.astro';
import type { Progetto } from '../data/progetti';
import { categoria } from '../lib/progetti';

interface Props {
  p: Progetto;
  /** Livello del titolo: h2 nelle liste, h3 nelle sezioni */
  h?: 'h2' | 'h3';
  eager?: boolean;
}
const { p, h: H = 'h3', eager = false } = Astro.props;
---
<article class="reveal">
  <a href={`/progetti/${p.slug}/`} class="card">
    <div class:list={['media', { 'is-drawing': p.disegno }]}>
      <span class="cat">{categoria(p.categorie[0]).etichetta}</span>
      <Picture img={p.copertina} sizes="(min-width: 1024px) 31vw, (min-width: 640px) 46vw, 92vw" eager={eager} />
    </div>
    <H>{p.titolo}</H>
    <p class="loc">{p.luogo}</p>
    <ul class="tags" aria-label="Caratteristiche del progetto">
      {p.tag.slice(0, 3).map((t) => <li>{t}</li>)}
    </ul>
  </a>
</article>
