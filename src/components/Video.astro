---
// Video: YouTube con anteprima locale, il lettore (youtube-nocookie) si carica solo al clic;
// file video del sito con il lettore del browser, caricato solo quando si preme play.
import Picture from './Picture.astro';
import type { Img } from '../lib/img';
import { fallbackSrc } from '../lib/img';

import type { VideoDati } from '../lib/video';

interface Props {
  video: VideoDati;
  didascalia?: string;
}
const { video, didascalia } = Astro.props;
---
<figure class="video">
  <div class="schermo" style={`aspect-ratio: ${video.poster.w} / ${video.poster.h}`}>
    {
      video.tipo === 'youtube' ? (
        <button type="button" class="avvia" data-youtube={video.id} data-titolo={video.titolo} aria-label={`Guarda il video: ${video.titolo}`}>
          <Picture img={video.poster} sizes="(min-width: 900px) 48rem, 92vw" />
          <span class="play" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M18 14v20l16-10z" fill="currentColor" /></svg>
          </span>
        </button>
      ) : (
        <video controls preload="none" playsinline poster={fallbackSrc(video.poster)} title={video.titolo}>
          <source src={video.src} type="video/mp4" />
          <a href={video.src}>Scarica il video</a>
        </video>
      )
    }
  </div>
  <figcaption class="xs muted mt-1">
    {didascalia ?? video.titolo}{video.tipo === 'youtube' && ' · il video si carica da YouTube quando lo avvii'}
  </figcaption>
</figure>

<style>
  .video {
    margin: 0;
  }
  .schermo {
    position: relative;
    width: 100%;
    background: var(--ink);
    overflow: hidden;
  }
  .schermo :global(iframe),
  .schermo video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .avvia {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: none;
  }
  .avvia :global(picture),
  .avvia :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 4.5rem;
    height: 4.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #222222d9;
    color: #fff;
    transition: scale 0.3s var(--ease), background 0.3s;
  }
  .play svg {
    width: 2.25rem;
    height: 2.25rem;
  }
  .avvia:hover .play,
  .avvia:focus-visible .play {
    scale: 1.08;
    background: #222;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-youtube]').forEach((b) =>
    b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.youtube}?autoplay=1&rel=0`;
      f.title = b.dataset.titolo || 'Video';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      b.replaceWith(f);
    }),
  );
</script>
