---
// Le fasi come percorso: una linea curva che passa per i numeri e si disegna con lo scroll. Ogni fase è una
// riga con testo e immagine ai due lati del percorso, alternati (testo a sinistra e foto a destra, poi il
// contrario); la riga compare quando la linea raggiunge il suo numero, così le fasi arrivano una alla volta.
// Su mobile la linea corre lungo il bordo sinistro e la foto sta sotto il testo.
import Picture from './Picture.astro';
import type { Img } from '../lib/img';

interface Props {
  fasi: { titolo: string; testo: string; foto?: { img: Img; disegno: boolean } }[];
}
const { fasi } = Astro.props;
---
<div class="percorso" data-percorso>
  <svg class="tracciato" aria-hidden="true" focusable="false">
    <path class="base" />
    <path class="avanzamento" />
  </svg>
  <ol class="tappe">
    {
      fasi.map((f, i) => (
        <li id={`fase-${i + 1}`} class:list={['tappa', i % 2 ? 'destra' : 'sinistra']}>
          <span class="nodo" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="testo">
            <p class="fase">Fase {String(i + 1).padStart(2, '0')}</p>
            <h3 class="h3">{f.titolo}</h3>
            <p>{f.testo}</p>
          </div>
          {f.foto && (
            <div class:list={['foto', { disegno: f.foto.disegno }]}>
              <Picture img={f.foto.img} sizes="(min-width: 900px) 40vw, 85vw" />
            </div>
          )}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .percorso {
    --nodo: 3rem;
    position: relative;
    margin-top: 3rem;
  }
  .tracciato {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .tracciato path {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .tracciato .base {
    stroke: #dddddd;
  }
  .tracciato .avanzamento {
    stroke: var(--ink);
  }
  .tappe {
    position: relative;
    display: grid;
    gap: 3.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* mobile: numero a sinistra (alternato di poco per far ondeggiare la linea), testo e poi foto */
  .tappa {
    --x: 1.5rem;
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding-left: 5rem;
  }
  .tappa.destra {
    --x: 3.25rem;
  }
  .nodo {
    position: absolute;
    top: 0;
    left: var(--x);
    translate: -50% 0;
    width: var(--nodo);
    height: var(--nodo);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--white);
    border: 1.5px solid #dddddd;
    color: var(--grey);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    transition:
      background 0.5s var(--ease),
      color 0.5s var(--ease),
      border-color 0.5s var(--ease),
      scale 0.5s var(--ease);
  }
  .tappa.is-attiva .nodo {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
    scale: 1.08;
  }
  .fase {
    color: var(--grey);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .testo h3 {
    margin-bottom: 0.75rem;
  }
  .testo p:last-child {
    max-width: 30rem;
  }
  .foto {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--grey-light);
  }
  .foto :global(picture) {
    display: block;
    height: 100%;
  }
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.08;
    transition: scale 1.6s var(--ease);
  }
  .foto.disegno {
    background: var(--white);
    border: 1px solid var(--line);
  }
  .foto.disegno :global(img) {
    object-fit: contain;
    padding: 0.75rem;
  }

  /* entrata: testo e foto arrivano dai rispettivi lati, la foto poco dopo il testo */
  .testo,
  .foto {
    opacity: 0;
    transition:
      opacity 0.9s var(--ease),
      translate 0.9s var(--ease);
  }
  .testo {
    translate: 0 18px;
  }
  .foto {
    translate: 0 28px;
    transition-delay: 0.15s;
  }
  .tappa.is-attiva .testo,
  .tappa.is-attiva .foto {
    opacity: 1;
    translate: 0 0;
  }
  .tappa.is-attiva .foto :global(img) {
    scale: 1;
  }
  :global(.no-js) .testo,
  :global(.no-js) .foto {
    opacity: 1;
    translate: none;
  }

  /* schermi larghi: testo e foto ai lati del percorso, alternati */
  @media (width >= 900px) {
    .tappe {
      gap: 6rem;
    }
    .tappa {
      --x: calc(50% - 1.75rem);
      grid-template-columns: 1fr 9rem 1fr;
      align-items: center;
      gap: 0;
      padding-left: 0;
    }
    .tappa.destra {
      --x: calc(50% + 1.75rem);
    }
    .nodo {
      top: 50%;
      translate: -50% -50%;
    }
    .sinistra .testo {
      grid-column: 1;
      text-align: right;
      justify-self: end;
      translate: -32px 0;
    }
    .sinistra .testo p:last-child {
      margin-left: auto;
    }
    .sinistra .foto {
      grid-column: 3;
      translate: 32px 0;
    }
    .destra .foto {
      grid-column: 1;
      grid-row: 1;
      translate: -32px 0;
    }
    .destra .testo {
      grid-column: 3;
      grid-row: 1;
      translate: 32px 0;
    }
    .tappa.is-attiva .testo,
    .tappa.is-attiva .foto {
      translate: 0 0;
    }
  }
</style>

<script>
  // Disegna una curva morbida che passa per il centro di ogni numero e la "srotola" fino a una linea
  // immaginaria al 60% dello schermo; le fasi sopra quella linea si accendono.
  document.querySelectorAll<HTMLElement>('[data-percorso]').forEach((percorso) => {
    const tappe = [...percorso.querySelectorAll<HTMLElement>('.tappa')];
    const nodi = tappe.map((t) => t.querySelector<HTMLElement>('.nodo')!);
    const svg = percorso.querySelector('svg')!;
    const base = svg.querySelector<SVGPathElement>('.base')!;
    const traccia = svg.querySelector<SVGPathElement>('.avanzamento')!;
    const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lunghezza = 0;
    let campioni: { y: number; l: number }[] = [];

    const costruisci = () => {
      const r = percorso.getBoundingClientRect();
      const punti = nodi.map((n) => {
        const b = n.getBoundingClientRect();
        return { x: b.left + b.width / 2 - r.left, y: b.top + b.height / 2 - r.top };
      });
      if (!punti.length) return;
      const primo = punti[0];
      const ultimo = punti[punti.length - 1];
      let d = `M ${primo.x} ${Math.max(primo.y - 80, 0)} L ${primo.x} ${primo.y}`;
      for (let i = 1; i < punti.length; i++) {
        const a = punti[i - 1];
        const b = punti[i];
        const dy = (b.y - a.y) / 2;
        d += ` C ${a.x} ${a.y + dy}, ${b.x} ${b.y - dy}, ${b.x} ${b.y}`;
      }
      d += ` L ${ultimo.x} ${Math.min(ultimo.y + 80, r.height)}`;
      svg.setAttribute('viewBox', `0 0 ${r.width} ${r.height}`);
      base.setAttribute('d', d);
      traccia.setAttribute('d', d);
      lunghezza = traccia.getTotalLength();
      traccia.style.strokeDasharray = `${lunghezza}`;
      campioni = [];
      for (let i = 0; i <= 400; i++) {
        const l = (lunghezza * i) / 400;
        campioni.push({ y: traccia.getPointAtLength(l).y, l });
      }
    };

    const aggiorna = () => {
      attesa = false;
      if (ridotto) {
        traccia.style.strokeDashoffset = '0';
        tappe.forEach((t) => t.classList.add('is-attiva'));
        return;
      }
      const r = percorso.getBoundingClientRect();
      const soglia = window.innerHeight * 0.6 - r.top;
      let l = 0;
      for (const c of campioni) {
        if (c.y <= soglia) l = c.l;
        else break;
      }
      traccia.style.strokeDashoffset = `${lunghezza - l}`;
      nodi.forEach((n, i) => {
        const b = n.getBoundingClientRect();
        tappe[i].classList.toggle('is-attiva', b.top + b.height / 2 - r.top <= soglia);
      });
    };

    let attesa = false;
    const richiedi = () => {
      if (!attesa) {
        attesa = true;
        requestAnimationFrame(aggiorna);
      }
    };
    costruisci();
    aggiorna();
    new ResizeObserver(() => {
      costruisci();
      aggiorna();
    }).observe(percorso);
    window.addEventListener('scroll', richiedi, { passive: true });
  });
</script>
