---
import Icon from './Icon.astro';
import { site, sitoIn, telHref, mailHref } from '../data/site';
import { nav } from '../data/nav';
import { servizi } from '../data/servizi';
import { categorie } from '../data/progetti';
import { lingua, loc, traduttore } from '../lib/lingua';

const anno = new Date().getFullYear();
const L = lingua(Astro.url);
const tr = traduttore(L);
const s = sitoIn(L);
---
<footer class="site-footer">
  <div class="container top">
    <div>
      <a href="/" class="brand" aria-label={`${site.nome} — home`}>
        <img src={site.logo.chiaro} width={site.logo.w} height={site.logo.h} alt={L === 'en' ? site.logo.altEn : site.logo.alt} fetchpriority="auto" decoding="async" />
      </a>
      <p class="mt-3" style="max-width: 22rem">{s.descrizioneFooter}</p>
      <div class="social">
        {
          site.social.map((so) => (
            <a href={so.url} target="_blank" rel="noopener me" aria-label={`${site.nome} ${tr('su', 'on')} ${so.nome}`}>
              <Icon name={so.nome.toLowerCase()} />
            </a>
          ))
        }
      </div>
    </div>
    <div>
      <h2>Studio</h2>
      <ul>
        {nav.map((v) => <li><a href={v.href}>{L === 'en' ? v.labelEn : v.label}</a></li>)}
        <li><a href="/mappa-del-sito/">{tr('Mappa del sito', 'Sitemap')}</a></li>
      </ul>
    </div>
    <div>
      <h2>{tr('Servizi', 'Services')}</h2>
      <ul>
        {servizi.map((x) => <li><a href={`/servizi/#${x.id}`}>{loc(x, L).nome}</a></li>)}
      </ul>
      <h2 class="mt-4">{tr('Progetti', 'Projects')}</h2>
      <ul>
        {categorie.map((c) => <li><a href={`/progetti/${c.id}/`}>{loc(c, L).nome}</a></li>)}
      </ul>
    </div>
    <div itemscope itemtype="https://schema.org/PostalAddress">
      <h2>{tr('Contatti', 'Contact')}</h2>
      <address style="font-style: normal">
        <p><strong style="color:#fff; font-weight:500">{site.nome}</strong></p>
        <p>
          {site.indirizzo.via && <Fragment><span itemprop="streetAddress">{site.indirizzo.via}</span><br /></Fragment>}{site.indirizzo.cap && <span itemprop="postalCode">{site.indirizzo.cap}</span>}
          <span itemprop="addressLocality">{site.indirizzo.citta}</span> (<span itemprop="addressRegion">{site.indirizzo.provincia}</span>)
        </p>
        <p class="mt-2"><a href={telHref}>Tel. {L === 'en' ? site.telefono.testoEn : site.telefono.testo}</a></p>
        <p><a href={mailHref}>{site.email}</a></p>
      </address>
      <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-link mt-3" style="display:inline-block; color: var(--accent-on-dark)">
        {tr('Indicazioni stradali', 'Directions')}
      </a>
    </div>
  </div>
  <div class="container bottom">
    <p>© {anno} {site.nome}{site.piva && ` · ${tr('P.IVA', 'VAT no.')} ${site.piva}`}</p>
    <nav aria-label={tr('Link legali', 'Legal links')}>
      <a href="/privacy-policy/">Privacy policy</a>
      <a href="/cookie-policy/">Cookie policy</a>
      <a href="/mappa-del-sito/">{tr('Mappa del sito', 'Sitemap')}</a>
    </nav>
  </div>
</footer>
